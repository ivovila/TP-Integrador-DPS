@startuml certiflow-domain
!pragma layout smetana
title Certiflow - Modelo de dominio (Entrega 1)
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

note as ExceptionsNote
  Las excepciones de dominio no se dibujan.
  Viven en el subpaquete exceptions de cada concepto
  (inspection.model.exceptions, schema.model.exceptions,
  certification.model.exceptions, catalog.model.exceptions)
  y extienden DomainException.
end note

package "shared.model" {
  class Person <<entidad>> {
    id: PersonId
    name: String
  }
  abstract class DomainException <<exception>>
}

package "shared.model (auditoria)" {
  interface "AuditLog<S>" as AuditLog <<puerto>> {
    +record(S, AuditEntry)
    +historyOf(S): List<AuditEntry>
    +recordAll(S, List<AuditEntry>)
  }
  class AuditTrail {
    +record(AuditAction, Person, Instant, detail)
    +pull(): List<AuditEntry>
  }
  class AuditEntry <<value object>> {
    action: AuditAction
    performedBy: Person
    occurredAt: Instant
    detail: String
  }
  interface AuditAction <<enum extensible>> {
    +label(): String
  }
  AuditLog ..> AuditEntry
  AuditEntry --> AuditAction
}

package "catalog.model" {
  class Asset <<entidad inmutable>> {
    code: AssetCode
    name: String
    type: AssetType
    location: Location
    responsible: Person
    characteristics: Characteristics
  }
  class Characteristics <<value object>> {
    entries: List<Characteristic>
    +valueOf(String): Optional<String>
  }
  class Characteristic <<value object>> {
    name: String
    value: String
  }
  Asset --> Characteristics
  Characteristics *-- Characteristic
  class AssetCode <<identificador de negocio>>
  class AssetType <<value object>>
  class Location <<value object>>
  class AssetService <<servicio de dominio>> {
    -assetLog: AuditLog<AssetCode>
    +register(Asset, Optional<Asset>, Person, Instant): Asset
  }
  enum AssetAudit {
    REGISTERED
  }
  AuditAction <|.. AssetAudit
  AssetService ..> Asset : da de alta y audita
  Asset --> AssetCode
  Asset --> AssetType
  Asset --> Location
}

package "schema.model (evaluacion)" {
  interface Answer
  class NumericAnswer <<value object>> {
    value: BigDecimal
  }
  enum YesNoAnswer {
    YES
    NO
  }
  class OptionAnswer <<value object>> {
    option: String
  }
  class Unit <<value object>>
  interface "ApprovalRule<A extends Answer>" as ApprovalRule {
    +isSatisfiedBy(A): boolean
  }
  class NumericRangeRule <<regla de NumericAnswer>> {
    unit: Unit
    range: Range
  }
  class YesNoRule <<regla de YesNoAnswer>> {
    expected: YesNoAnswer
  }
  class OptionInListRule <<regla de OptionAnswer>> {
    acceptedOptions: Set<String>
  }
  class Range <<value object>> {
    minimum: BigDecimal
    maximum: BigDecimal
    +contains(BigDecimal): boolean
  }
  enum Outcome {
    PENDING
    APPROVED
    OBSERVED
    REJECTED
    +raisesFinding(): boolean
  }
  interface Severity <<enum extensible>> {
    +label(): String
    +outcomeWhenUnmet(): Outcome
    +blocksCertification(): boolean
  }
  enum StandardSeverity {
    MINOR
    MAJOR
    CRITICAL
  }
  interface EvidenceKind <<enum extensible>> {
    +label(): String
  }
  enum StandardEvidenceKind {
    PHOTO
    DOCUMENT
  }
  class Evidence <<value object>> {
    kind: EvidenceKind
    reference: String
    description: String
    +isOfKind(EvidenceKind): boolean
    +isSameFileAs(Evidence): boolean
  }
  class EvidenceRequirement <<value object>> {
    kind: EvidenceKind
    minimum: int
    +isSatisfiedBy(List<Evidence>): boolean
  }
  Answer <|.. NumericAnswer
  Answer <|.. YesNoAnswer
  Answer <|.. OptionAnswer
  ApprovalRule <|.. NumericRangeRule
  ApprovalRule <|.. YesNoRule
  ApprovalRule <|.. OptionInListRule
  NumericRangeRule --> Range
  Severity <|.. StandardSeverity
  Severity ..> Outcome
  EvidenceKind <|.. StandardEvidenceKind
  Evidence --> EvidenceKind
  EvidenceRequirement --> EvidenceKind
}

package "schema.model" {
  class InspectionSchema <<aggregate root inmutable>> {
    name: String
    assetType: AssetType
    versionLog: SchemaVersionLog
    +withNewVersion(List<Section>, Instant): InspectionSchema
    +currentVersion(): SchemaVersion
    +appliesTo(AssetType): boolean
  }
  class SchemaVersionLog <<value object inmutable>> {
    versions: List<SchemaVersion>
    +{static} startingWith(List<Section>, Instant): SchemaVersionLog
    +append(List<Section>, Instant): SchemaVersionLog
    +current(): SchemaVersion
  }
  class SchemaVersion <<value object inmutable>> {
    number: int
    sections: List<Section>
    publishedAt: Instant
    +criteria(): List<Criterion<?>>
    +ensureContains(Criterion<?>)
  }
  class Section <<value object>> {
    title: String
    criteria: List<Criterion<?>>
  }
  class "Criterion<A extends Answer>" as Criterion <<value object>> {
    code: String
    text: String
    rule: ApprovalRule<A>
    severity: Severity
    requiredEvidence: List<EvidenceRequirement>
    +outcomeOf(A): Outcome
    +evidenceRequirementsMetBy(List<Evidence>): boolean
  }
  class InspectionSchemaService <<servicio de dominio>> {
    -schemaLog: AuditLog<AssetType>
    +create(name, AssetType, List<Section>, Person, Instant): InspectionSchema
    +addVersion(InspectionSchema, List<Section>, Person, Instant): InspectionSchema
  }
  enum SchemaAudit {
    CREATED
    VERSION_ADDED
  }
  AuditAction <|.. SchemaAudit
  InspectionSchemaService ..> InspectionSchema : crea versiones y audita
  InspectionSchema *-- SchemaVersionLog
  SchemaVersionLog "1" *-- "1..*" SchemaVersion
  SchemaVersion *-- "1..*" Section
  Section *-- "1..*" Criterion
  Criterion --> ApprovalRule
  Criterion --> Severity
  Criterion --> "*" EvidenceRequirement
  InspectionSchema --> AssetType
}

package "inspection.model" {
  interface InspectionView <<solo lectura>> {
    +id(): InspectionId
    +evaluate(): Evaluation
    +isClosed(): boolean
    +originalRevision(): Revision
    +revisions(): List<Revision>
    +assetCode(): AssetCode
    +assetResponsible(): Person
    +coversWholeSchema(): boolean
    +assignment(): InspectionAssignment
    +schemaVersion(): SchemaVersion
  }
  class Inspection <<aggregate root>> {
    -responses: Map<Criterion<?>, CriterionResponse<?>>
    -revisions: List<Revision>
    -auditTrail: AuditTrail
    ~recordAnswer(Criterion<A>, A, Person, Instant)
    ~attachEvidence(Criterion<?>, Evidence, Person, Instant)
    ~addObservation(Criterion<?>, String, Person, Instant)
    ~close(Person, Instant): InspectionClosed
    ~rectify(Criterion<A>, A, reason, Person, Instant): InspectionRectified
    ~pullAuditEntries(): List<AuditEntry>
    +ensureClosed()
  }
  class InspectionFactory {
    +create(InspectionId, Asset, InspectionAssignment, SchemaVersion, Person, Instant): Inspection
  }
  class InspectionService <<servicio de dominio>> {
    -inspectionFactory: InspectionFactory
    -inspectionLog: AuditLog<Inspection>
    +assign(InspectionId, Asset, InspectionAssignment, SchemaVersion, Person, Instant): Inspection
    +recordAnswer(Inspection, Criterion<A>, A, Person, Instant)
    +attachEvidence(Inspection, Criterion<?>, Evidence, Person, Instant)
    +addObservation(Inspection, Criterion<?>, String, Person, Instant)
    +close(Inspection, Person, Instant): InspectionClosed
    +rectify(Inspection, Criterion<A>, A, reason, Person, Instant): InspectionRectified
  }
  class InspectionClosed <<evento de dominio>> {
    inspectionId: InspectionId
    assetCode: AssetCode
    assetResponsible: Person
    nonConformities: List<CriterionResponse<?>>
  }
  class InspectionRectified <<evento de dominio>> {
    inspectionId: InspectionId
    assetCode: AssetCode
    assetResponsible: Person
    nonConformities: List<CriterionResponse<?>>
  }
  class InspectionAssignment <<value object>> {
    inspector: Person
    plannedDate: LocalDate
    scope: InspectionScope
  }
  interface InspectionScope {
    +criteriaIn(SchemaVersion): List<Criterion<?>>
  }
  class FullScope <<value object>>
  class SectionsScope <<value object>> {
    sectionTitles: Set<String>
  }
  InspectionScope <|.. FullScope
  InspectionScope <|.. SectionsScope
  InspectionAssignment --> InspectionScope
  class "CriterionResponse<A extends Answer>" as CriterionResponse <<value object inmutable>> {
    criterion: Criterion<A>
    given: Optional<GivenAnswer<A>>
    attachments: List<AttachedEvidence>
    observations: List<Observation>
    +answeredWith(Criterion<B>, B, Person, Instant): CriterionResponse<B>
    +withEvidence(Evidence, Person, Instant)
    +withObservation(Observation)
    +outcome(): Outcome
    +isFor(Criterion<?>): boolean
  }
  class "GivenAnswer<A extends Answer>" as GivenAnswer <<value object>> {
    value: A
    answeredBy: Person
    answeredAt: Instant
  }
  class AttachedEvidence <<value object>> {
    evidence: Evidence
    attachedBy: Person
    attachedAt: Instant
  }
  class Observation <<value object>> {
    text: String
    observedBy: Person
    observedAt: Instant
  }
  class Evaluation <<value object>> {
    responses: List<CriterionResponse<?>>
    +outcomeOf(Criterion<?>): Outcome
    +pending(): List<CriterionResponse<?>>
    +nonConformities(): List<CriterionResponse<?>>
    +ensureComplete()
  }
  class Revisions <<coleccion de primera clase>> {
    +sealedWith(reason, Evaluation, Person, Instant): Revisions
    +original(): Revision
    +last(): Revision
    +size(): int
    +isEmpty(): boolean
  }
  class Revision <<value object>> {
    number: int
    reason: String
    evaluation: Evaluation
    sealedBy: Person
    sealedAt: Instant
  }
  enum InspectionAudit {
    ASSIGNED
    ANSWER_RECORDED
    EVIDENCE_ATTACHED
    OBSERVATION_ADDED
    CLOSED
    RECTIFIED
  }
  InspectionView <|.. Inspection
  InspectionFactory ..> Inspection : crea
  Inspection *-- AuditTrail
  Inspection --> Asset
  Inspection --> InspectionAssignment
  Inspection --> SchemaVersion : fijada al asignar
  Inspection *-- "*" CriterionResponse
  Inspection *-- Revisions
  Revisions *-- "*" Revision
  Inspection ..> Evaluation : deriva
  Revision --> Evaluation
  Evaluation o-- "*" CriterionResponse
  CriterionResponse --> Criterion
  CriterionResponse --> "0..1" GivenAnswer
  CriterionResponse --> "*" AttachedEvidence
  CriterionResponse --> "*" Observation
  GivenAnswer --> Answer
  AttachedEvidence --> Evidence
  AuditAction <|.. InspectionAudit
}

package "inspection.model (hallazgos)" {
  class Finding <<aggregate root>> {
    -auditTrail: AuditTrail
    ~planAction(description, Person, LocalDate, Person, Instant, LocalDate): CorrectiveAction
    ~verifyAction(CorrectiveActionId, Person, VerificationResult, notes, Instant): Verification
    +isOpen(): boolean
    +blocksCertification(): boolean
    +concerns(AssetCode): boolean
    +isOpenFor(InspectionId, CriterionResponse<?>): boolean
    +id(): FindingId
    +inspectionId(): InspectionId
    +criterion(): Criterion<?>
    +severity(): Severity
    +evidence(): List<AttachedEvidence>
    +responsible(): Person
    +actions(): List<CorrectiveAction>
    ~pullAuditEntries(): List<AuditEntry>
  }
  class FindingFactory {
    +create(FindingId, InspectionId, AssetCode, Person, CriterionResponse<?>, Person, Instant): Finding
  }
  class FindingService <<servicio de dominio>> {
    -findingFactory: FindingFactory
    -findingLog: AuditLog<Finding>
    +raiseFrom(InspectionClosed, Supplier<FindingId>): List<Finding>
    +raiseFrom(InspectionRectified, List<Finding>, Supplier<FindingId>): List<Finding>
    +planAction(Finding, description, Person, LocalDate, Person, Instant, LocalDate): CorrectiveAction
    +verifyAction(Finding, CorrectiveActionId, Person, VerificationResult, notes, Instant): Verification
  }
  class CorrectiveActions <<coleccion de primera clase, de paquete>> {
    ~plan(description, Person, LocalDate, Person, Instant, LocalDate): CorrectiveAction
    ~withId(CorrectiveActionId): CorrectiveAction
    ~cancelOpen(Person, Instant)
    ~noneAccepted(): boolean
  }
  class CorrectiveAction <<entidad interna>> {
    -description: String
    -responsible: Person
    -dueDate: LocalDate
    -plannedBy: Person
    -plannedAt: Instant
    -verifications: List<Verification>
    -cancellation: Cancellation
    ~verify(Person, VerificationResult, notes, Instant): Verification
    ~cancel(Person, Instant)
    +isClosed(): boolean
    +isCancelled(): boolean
    +isOpen(): boolean
    +isOverdueOn(LocalDate): boolean
  }
  class Verification <<value object>> {
    verifier: Person
    result: VerificationResult
    notes: String
    verifiedAt: Instant
    +isAccepted(): boolean
  }
  enum VerificationResult {
    ACCEPTED
    REJECTED
    +closesAction(): boolean
    +requiresNotes(): boolean
    +audit(): FindingAudit
  }
  class Cancellation <<value object>> {
    cancelledBy: Person
    cancelledAt: Instant
  }
  enum FindingAudit {
    RAISED
    ACTION_PLANNED
    VERIFICATION_ACCEPTED
    VERIFICATION_REJECTED
  }
  FindingFactory ..> Finding : crea
  Finding *-- CorrectiveActions
  CorrectiveActions *-- CorrectiveAction
  Finding *-- AuditTrail
  Finding --> InspectionId : por id
  Finding --> Criterion
  Finding --> "*" AttachedEvidence
  CorrectiveAction *-- "*" Verification
  Verification --> VerificationResult
  AuditAction <|.. FindingAudit
}

package "certification.model" {
  class Certificate <<aggregate root>> {
    -lifecycle: CertificateLifecycle
    -auditTrail: AuditTrail
    ~suspend(reason, Person, Instant, LocalDate)
    ~ensureRenewableWith(InspectionView)
    ~renew(CertificateNumber, ValidityPeriod, InspectionView, Person, Instant): Certificate
    +statusOn(LocalDate): CertificateStatus
    +isCurrentOn(LocalDate): boolean
    +certifies(AssetCode): boolean
    +number(): CertificateNumber
    +assetCode(): AssetCode
    +basedOn(): InspectionReference
    +validity(): ValidityPeriod
    +issuedBy(): Person
    +issuedAt(): Instant
    +suspensions(): List<Suspension>
    ~pullAuditEntries(): List<AuditEntry>
  }
  class CertificateFactory {
    +create(CertificateNumber, AssetCode, InspectionView, ValidityPeriod, Person, Instant): Certificate
  }
  class CertificateService <<servicio de dominio>> {
    -certificateFactory: CertificateFactory
    -certificateLog: AuditLog<Certificate>
    +issue(CertificateNumber, AssetCode, InspectionView, ValidityPeriod, Person, Instant): Certificate
    +ensureRenewableWith(Certificate, InspectionView)
    +renew(Certificate, CertificateNumber, ValidityPeriod, InspectionView, Person, Instant): Certificate
    +suspend(Certificate, reason, Person, Instant, LocalDate)
  }
  class CertificateNumber <<identificador de negocio>>
  class ValidityPeriod <<value object>> {
    validFrom: LocalDate
    validUntil: LocalDate
    +covers(LocalDate): boolean
  }
  class Suspension <<value object>> {
    reason: String
    suspendedBy: Person
    suspendedAt: Instant
  }
  enum CertificateLifecycle <<de paquete>> {
    ISSUED
    SUSPENDED
    RENEWED
    ~statusOn(ValidityPeriod, LocalDate): CertificateStatus
  }
  enum CertificateStatus {
    ACTIVE
    EXPIRED
    SUSPENDED
    RENEWED
  }
  enum CertificateAudit {
    ISSUED
    SUSPENDED
    RENEWED
  }
  CertificateFactory ..> Certificate : crea
  Certificate *-- AuditTrail
  Certificate --> CertificateNumber
  Certificate --> Asset
  Certificate --> InspectionReference : basedOn (id + cierre)
  Certificate --> ValidityPeriod
  Certificate --> CertificateLifecycle
  Certificate *-- "*" Suspension
  CertificateLifecycle ..> CertificateStatus : deriva
  AuditAction <|.. CertificateAudit
}

package "<contexto>.repository" {
  interface AssetRepository {
    +save(Asset)
    +findByCode(AssetCode): Optional<Asset>
  }
  interface InspectionSchemaRepository {
    +save(InspectionSchema)
    +findByAssetType(AssetType): Optional<InspectionSchema>
  }
  interface InspectionRepository {
    +nextId(): InspectionId
    +save(Inspection)
    +findById(InspectionId): Optional<Inspection>
  }
  interface FindingRepository {
    +nextId(): FindingId
    +save(Finding)
    +saveAll(List<Finding>)
    +findById(FindingId): Optional<Finding>
    +findByAsset(AssetCode): List<Finding>
  }
  interface CertificateRepository {
    +save(Certificate)
    +findByNumber(CertificateNumber): Optional<Certificate>
    +findCurrentFor(AssetCode, LocalDate): Optional<Certificate>
  }
  interface CertificateNumbering {
    +next(): CertificateNumber
  }
}

package "certification.model (elegibilidad)" {
  interface CertificationEligibility <<servicio de dominio, politica intercambiable>> {
    +evaluate(InspectionResult): CertificationDecision
    +ensureEligible(InspectionResult)
  }
  class NoBlockingFindingsEligibility
  class CertificationDecision <<value object>> {
    ineligibilities: List<Ineligibility>
    +isEligible(): boolean
    +isBlockedBy(IneligibilityReason): boolean
  }
  class Ineligibility <<value object>> {
    reason: IneligibilityReason
    detail: String
  }
  enum IneligibilityReason {
    INSPECTION_NOT_CLOSED
    PARTIAL_INSPECTION
    BLOCKING_FINDINGS
  }
  class InspectionResult <<value object, ACL>> {
    inspectionId: InspectionId
    assetCode: AssetCode
    closedAt: Optional<Instant>
    coversWholeSchema: boolean
    openNonConformities: List<OpenNonConformity>
    +reference(): InspectionReference
    +blockingNonConformities(): List<OpenNonConformity>
  }
  class OpenNonConformity <<value object>> {
    criterionCode: String
    severity: Severity
  }
  interface InspectionResultTranslator <<puerto del ACL>> {
    +translate(InspectionId): InspectionResult
  }
  CertificationEligibility ..> InspectionResult
  InspectionResult *-- OpenNonConformity
  InspectionResultTranslator ..> InspectionResult
  CertificationEligibility ..> CertificationDecision
  CertificationDecision *-- Ineligibility
  Ineligibility --> IneligibilityReason
}

package "<contexto>.usecase (certiflow-domain)" {
  interface "Casos de uso: una interfaz por caso" as UseCases <<puertos de entrada>> {
    RegisterAsset
    CreateInspectionSchema / PublishSchemaVersion
    AssignInspection
    RecordAnswer / AttachEvidence / AddObservation
    CloseInspection / RectifyInspection
    PlanCorrectiveAction / VerifyCorrectiveAction
    IssueCertificate / SuspendCertificate / RenewCertificate / EvaluateCertification
    GenerateInspectionAct / GenerateFindingsSummary / GenerateCertificateDocument
    ..reciben un XxxCommand con ids y codigos..
  }
  class "Modelos de lectura (<contexto>.usecase)" as ReadModels {
    InspectionAct / ActLine
    FindingsSummary / FindingLine
    CertificateDocument
    ..records sin formato..
  }
  UseCases ..> ReadModels : los informes los devuelven
}

package "application.<contexto> (certiflow-application)" {
  class "XxxUseCaseImpl implements XxxUseCase" as Interactors {
    ..una implementación por caso de uso..
    ..busca por id, llama al servicio de dominio y guarda..
  }
}

Interactors ..|> UseCases
class InspectionResultTranslatorImpl <<ACL>>
InspectionResultTranslator <|.. InspectionResultTranslatorImpl
InspectionResultTranslatorImpl ..> InspectionRepository
InspectionResultTranslatorImpl ..> FindingRepository
CertificationEligibility <|.. NoBlockingFindingsEligibility
Interactors ..> AssetRepository
Interactors ..> InspectionSchemaRepository
Interactors ..> InspectionRepository
Interactors ..> FindingRepository
Interactors ..> CertificateRepository
Interactors ..> CertificateNumbering
Interactors ..> CertificationEligibility
Interactors ..> AuditLog : solo el acta lo lee
Interactors ..> InspectionService
Interactors ..> FindingService
Interactors ..> CertificateService
Interactors ..> AssetService
Interactors ..> InspectionSchemaService
InspectionService ..> AuditLog : vuelca la bitacora
FindingService ..> AuditLog : vuelca la bitacora
CertificateService ..> AuditLog : vuelca la bitacora

package "infrastructure.inmemory (certiflow-infrastructure)" {
  class InMemoryAssetRepository
  class InMemoryInspectionSchemaRepository
  class InMemoryInspectionRepository
  class InMemoryFindingRepository
  class InMemoryCertificateRepository
  class "InMemoryAuditLog<S>" as InMemoryAuditLog
  class SequentialCertificateNumbering
  AssetRepository <|.. InMemoryAssetRepository
  InspectionSchemaRepository <|.. InMemoryInspectionSchemaRepository
  InspectionRepository <|.. InMemoryInspectionRepository
  FindingRepository <|.. InMemoryFindingRepository
  CertificateRepository <|.. InMemoryCertificateRepository
  AuditLog <|.. InMemoryAuditLog
  CertificateNumbering <|.. SequentialCertificateNumbering
}

note as Snapshots
  Inspection, Finding y Certificate exportan snapshot()
  (InspectionSnapshot, FindingSnapshot, CertificateSnapshot)
  y se reconstruyen con XxxFactory.restore(snapshot).
  Los adaptadores JPA (infrastructure.<contexto>.persistence)
  traducen snapshots a entidades.
end note
@enduml
