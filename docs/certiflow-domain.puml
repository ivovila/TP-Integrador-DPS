@startuml certiflow-domain
!pragma layout smetana
title Certiflow - Modelo de dominio (Entrega 1)
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

note as ExceptionsNote
  Las excepciones de dominio no se dibujan.
  Viven en el subpaquete exceptions de cada concepto
  (models.inspection.exceptions, models.finding.exceptions,
  models.certificate.exceptions, models.schema.exceptions)
  y extienden DomainException. Las de aplicacion viven en
  application.exceptions.
end note

package "models.shared" {
  class Person <<value object>> {
    name: String
  }
  abstract class DomainException <<exception>>
}

package "models.audit" {
  interface AuditService <<puerto>> {
    +record(AuditEntry)
    +entriesFor(subject): List<AuditEntry>
  }
  class AuditTrail {
    -auditService: AuditService
    +record(subject, AuditAction, Person, Instant, detail)
  }
  class AuditEntry <<value object>> {
    subject: Object
    action: AuditAction
    performedBy: Person
    occurredAt: Instant
    detail: String
    +concerns(candidate): boolean
  }
  interface AuditAction <<enum extensible>> {
    +label(): String
  }
  AuditTrail --> AuditService : entrega cada entrada
  AuditTrail ..> AuditEntry : construye
  AuditService ..> AuditEntry
  AuditEntry --> AuditAction
}

package "models.asset" {
  class Asset <<entidad inmutable>> {
    code: AssetCode
    name: String
    type: AssetType
    location: Location
    responsible: Person
    characteristics: Map<String,String>
  }
  class AssetCode <<identificador de negocio>>
  class AssetType <<value object>>
  class Location <<value object>>
  Asset --> AssetCode
  Asset --> AssetType
  Asset --> Location
}

package "models.evaluation" {
  interface Answer
  class NumericAnswer <<value object>> {
    value: BigDecimal
  }
  enum YesNoAnswer {
    YES
    NO
  }
  class OptionAnswer <<value object>> {
    option: String
  }
  class Unit <<value object>>
  interface "ApprovalRule<A extends Answer>" as ApprovalRule {
    +isSatisfiedBy(A): boolean
  }
  class NumericRangeRule <<regla de NumericAnswer>> {
    unit: Unit
    range: Range
  }
  class YesNoRule <<regla de YesNoAnswer>> {
    expected: YesNoAnswer
  }
  class OptionInListRule <<regla de OptionAnswer>> {
    acceptedOptions: Set<String>
  }
  class Range <<value object>> {
    minimum: BigDecimal
    maximum: BigDecimal
    +contains(BigDecimal): boolean
  }
  enum Outcome {
    PENDING
    APPROVED
    OBSERVED
    REJECTED
    +raisesFinding(): boolean
  }
  interface Severity <<enum extensible>> {
    +label(): String
    +outcomeWhenUnmet(): Outcome
    +blocksCertification(): boolean
  }
  enum StandardSeverity {
    MINOR
    MAJOR
    CRITICAL
  }
  interface EvidenceKind <<enum extensible>> {
    +label(): String
  }
  enum StandardEvidenceKind {
    PHOTO
    DOCUMENT
  }
  class Evidence <<value object>> {
    kind: EvidenceKind
    reference: String
    description: String
    +isOfKind(EvidenceKind): boolean
  }
  class EvidenceRequirement <<value object>> {
    kind: EvidenceKind
    minimum: int
    +isSatisfiedBy(List<Evidence>): boolean
  }
  Answer <|.. NumericAnswer
  Answer <|.. YesNoAnswer
  Answer <|.. OptionAnswer
  ApprovalRule <|.. NumericRangeRule
  ApprovalRule <|.. YesNoRule
  ApprovalRule <|.. OptionInListRule
  NumericRangeRule --> Range
  Severity <|.. StandardSeverity
  Severity ..> Outcome
  EvidenceKind <|.. StandardEvidenceKind
  Evidence --> EvidenceKind
  EvidenceRequirement --> EvidenceKind
}

package "models.schema" {
  class InspectionSchema <<aggregate root>> {
    -name: String
    -assetType: AssetType
    -versions: List<SchemaVersion>
    +publish(List<Section>, Instant): SchemaVersion
    +currentVersion(): SchemaVersion
    +appliesTo(AssetType): boolean
  }
  class SchemaVersion <<value object inmutable>> {
    number: int
    sections: List<Section>
    publishedAt: Instant
    +criteria(): List<Criterion<?>>
    +ensureContains(Criterion<?>)
  }
  class Section <<value object>> {
    title: String
    criteria: List<Criterion<?>>
  }
  class "Criterion<A extends Answer>" as Criterion <<value object>> {
    code: String
    text: String
    rule: ApprovalRule<A>
    severity: Severity
    requiredEvidence: List<EvidenceRequirement>
    +outcomeOf(A): Outcome
    +evidenceRequirementsMetBy(List<Evidence>): boolean
  }
  InspectionSchema "1" *-- "1..*" SchemaVersion
  SchemaVersion *-- "1..*" Section
  Section *-- "1..*" Criterion
  Criterion --> ApprovalRule
  Criterion --> Severity
  Criterion --> "*" EvidenceRequirement
  InspectionSchema --> AssetType
}

package "models.inspection" {
  interface InspectionView <<solo lectura>> {
    +evaluate(): Evaluation
    +isClosed(): boolean
    +originalRevision(): Revision
    +revisions(): List<Revision>
    +asset(): Asset
    +assignment(): InspectionAssignment
    +schemaVersion(): SchemaVersion
  }
  interface Inspection {
    +recordAnswer(Criterion<A>, A, Person, Instant)
    +attachEvidence(Criterion<?>, Evidence, Person, Instant)
    +addObservation(Criterion<?>, String, Person, Instant)
    +close(Person, Instant)
    +rectify(Criterion<A>, A, reason, Person, Instant)
  }
  class StandardInspection <<de paquete>> {
    -responses: Map<Criterion<?>, CriterionResponse<?>>
    -revisions: List<Revision>
    -ensureOpen()
    -ensureClosed()
  }
  class AuditedInspection <<decorator, de paquete>> {
    -auditTrail: AuditTrail
  }
  class AuditedInspectionGenerator {
    -auditTrail: AuditTrail
    +AuditedInspectionGenerator(AuditService)
    +generate(Asset, InspectionAssignment, SchemaVersion, Person, Instant): Inspection
  }
  class InspectionAssignment <<value object>> {
    inspector: Person
    plannedDate: LocalDate
    scope: String
  }
  class "CriterionResponse<A extends Answer>" as CriterionResponse <<value object inmutable>> {
    criterion: Criterion<A>
    given: Optional<GivenAnswer<A>>
    attachments: List<AttachedEvidence>
    observations: List<Observation>
    +answeredWith(Criterion<B>, B, Person, Instant): CriterionResponse<B>
    +withEvidence(Evidence, Person, Instant)
    +withObservation(Observation)
    +outcome(): Outcome
    +isFor(Criterion<?>): boolean
  }
  class "GivenAnswer<A extends Answer>" as GivenAnswer <<value object>> {
    value: A
    answeredBy: Person
    answeredAt: Instant
  }
  class AttachedEvidence <<value object>> {
    evidence: Evidence
    attachedBy: Person
    attachedAt: Instant
  }
  class Observation <<value object>> {
    text: String
    observedBy: Person
    observedAt: Instant
  }
  class Evaluation <<value object>> {
    responses: List<CriterionResponse<?>>
    +outcomeOf(Criterion<?>): Outcome
    +pending(): List<CriterionResponse<?>>
    +nonConformities(): List<CriterionResponse<?>>
    +ensureComplete()
  }
  class Revision <<value object>> {
    number: int
    reason: String
    evaluation: Evaluation
    sealedBy: Person
    sealedAt: Instant
  }
  enum InspectionAudit {
    ASSIGNED
    ANSWER_RECORDED
    EVIDENCE_ATTACHED
    OBSERVATION_ADDED
    CLOSED
    RECTIFIED
  }
  InspectionView <|-- Inspection
  Inspection <|.. StandardInspection
  Inspection <|.. AuditedInspection
  AuditedInspection o--> Inspection : decora
  AuditedInspection --> AuditTrail
  AuditedInspectionGenerator ..> AuditedInspection : compone
  AuditedInspectionGenerator ..> StandardInspection : compone
  AuditedInspectionGenerator --> AuditTrail : crea a partir del AuditService
  StandardInspection --> Asset
  StandardInspection --> InspectionAssignment
  StandardInspection --> SchemaVersion : fijada al asignar
  StandardInspection *-- "*" CriterionResponse
  StandardInspection *-- "*" Revision
  StandardInspection ..> Evaluation : deriva
  Revision --> Evaluation
  Evaluation o-- "*" CriterionResponse
  CriterionResponse --> Criterion
  CriterionResponse --> "0..1" GivenAnswer
  CriterionResponse --> "*" AttachedEvidence
  CriterionResponse --> "*" Observation
  GivenAnswer --> Answer
  AttachedEvidence --> Evidence
  AuditAction <|.. InspectionAudit
}

package "models.finding" {
  interface Finding {
    +planAction(description, Person, LocalDate, Person, Instant): CorrectiveAction
    +verifyAction(CorrectiveAction, Person, VerificationResult, notes, Instant): Verification
    +isOpen(): boolean
    +blocksCertification(): boolean
    +concerns(Asset): boolean
    +inspection(): InspectionView
    +criterion(): Criterion<?>
    +severity(): Severity
    +evidence(): List<AttachedEvidence>
    +responsible(): Person
    +actions(): List<CorrectiveAction>
  }
  class StandardFinding <<de paquete>>
  class AuditedFinding <<decorator, de paquete>> {
    -auditTrail: AuditTrail
  }
  class AuditedFindingGenerator {
    -auditTrail: AuditTrail
    +AuditedFindingGenerator(AuditService)
    +generate(CriterionResponse<?>, InspectionView, Person, Instant): Finding
  }
  class CorrectiveAction <<entidad interna>> {
    -description: String
    -responsible: Person
    -dueDate: LocalDate
    -plannedBy: Person
    -plannedAt: Instant
    -verifications: List<Verification>
    ~verify(Person, VerificationResult, notes, Instant): Verification
    +isClosed(): boolean
    +isOverdueOn(LocalDate): boolean
  }
  class Verification <<value object>> {
    verifier: Person
    result: VerificationResult
    notes: String
    verifiedAt: Instant
    +isAccepted(): boolean
  }
  enum VerificationResult {
    ACCEPTED
    REJECTED
    +closesAction(): boolean
  }
  enum FindingAudit {
    RAISED
    ACTION_PLANNED
    VERIFICATION_ACCEPTED
    VERIFICATION_REJECTED
  }
  Finding <|.. StandardFinding
  Finding <|.. AuditedFinding
  AuditedFinding o--> Finding : decora
  AuditedFinding --> AuditTrail
  AuditedFindingGenerator ..> AuditedFinding : compone
  AuditedFindingGenerator ..> StandardFinding : compone
  AuditedFindingGenerator --> AuditTrail : crea a partir del AuditService
  StandardFinding --> InspectionView : solo lectura
  StandardFinding --> Criterion
  StandardFinding --> "*" AttachedEvidence
  StandardFinding *-- "*" CorrectiveAction
  CorrectiveAction *-- "*" Verification
  Verification --> VerificationResult
  AuditAction <|.. FindingAudit
}

package "models.certificate" {
  interface Certificate {
    +suspend(reason, Person, Instant)
    +renew(CertificateNumber, ValidityPeriod, InspectionView, Person, Instant): Certificate
    +statusOn(LocalDate): CertificateStatus
    +isCurrentOn(LocalDate): boolean
    +certifies(Asset): boolean
    +number(): CertificateNumber
    +asset(): Asset
    +basedOn(): InspectionView
    +validity(): ValidityPeriod
    +issuedBy(): Person
    +issuedAt(): Instant
    +suspensions(): List<Suspension>
  }
  class StandardCertificate <<de paquete>> {
    -lifecycle: CertificateLifecycle
  }
  class AuditedCertificate <<decorator, de paquete>> {
    -auditTrail: AuditTrail
    ..al renovar decora y audita el certificado nuevo..
  }
  class AuditedCertificateGenerator {
    -auditTrail: AuditTrail
    +AuditedCertificateGenerator(AuditService)
    +generate(CertificateNumber, Asset, InspectionView, ValidityPeriod, Person, Instant): Certificate
  }
  class CertificateNumber <<identificador de negocio>>
  class ValidityPeriod <<value object>> {
    validFrom: LocalDate
    validUntil: LocalDate
    +covers(LocalDate): boolean
  }
  class Suspension <<value object>> {
    reason: String
    suspendedBy: Person
    suspendedAt: Instant
  }
  enum CertificateLifecycle <<de paquete>> {
    ISSUED
    SUSPENDED
    RENEWED
    ~statusOn(ValidityPeriod, LocalDate): CertificateStatus
  }
  enum CertificateStatus {
    ACTIVE
    EXPIRED
    SUSPENDED
    RENEWED
  }
  enum CertificateAudit {
    ISSUED
    SUSPENDED
    RENEWED
  }
  Certificate <|.. StandardCertificate
  Certificate <|.. AuditedCertificate
  AuditedCertificate o--> Certificate : decora
  AuditedCertificate --> AuditTrail
  AuditedCertificateGenerator ..> AuditedCertificate : compone
  AuditedCertificateGenerator ..> StandardCertificate : compone
  AuditedCertificateGenerator --> AuditTrail : crea a partir del AuditService
  StandardCertificate --> CertificateNumber
  StandardCertificate --> Asset
  StandardCertificate --> InspectionView : basedOn, solo lectura
  StandardCertificate --> ValidityPeriod
  StandardCertificate --> CertificateLifecycle
  StandardCertificate *-- "*" Suspension
  CertificateLifecycle ..> CertificateStatus : deriva
  AuditAction <|.. CertificateAudit
}

package "ports" {
  interface AssetRepository {
    +save(Asset)
    +findByCode(AssetCode): Optional<Asset>
  }
  interface InspectionSchemaRepository {
    +save(InspectionSchema)
    +findByAssetType(AssetType): Optional<InspectionSchema>
  }
  interface InspectionRepository {
    +save(Inspection)
    +findByAsset(Asset): List<Inspection>
  }
  interface FindingRepository {
    +save(Finding)
    +saveAll(List<Finding>)
    +findByAsset(Asset): List<Finding>
  }
  interface CertificateRepository {
    +save(Certificate)
    +findCurrentFor(Asset, LocalDate): Optional<Certificate>
  }
  interface CertificateNumbering {
    +next(): CertificateNumber
  }
}

package "application" {
  interface CertificationEligibility <<politica intercambiable>> {
    +ensureEligible(Inspection)
  }
  class NoBlockingFindingsEligibility
  class "Modelos de lectura (application.report)" as ReadModels {
    InspectionAct / ActLine
    FindingsSummary / FindingLine
    CertificateDocument
    ..records sin formato..
  }
}

package "usecases" {
  class "Casos de uso (uno por clase)" as UseCases {
    RegisterAsset
    CreateInspectionSchema / PublishSchemaVersion
    AssignInspection
    RecordAnswer / AttachEvidence / AddObservation
    CloseInspection / RectifyInspection
    PlanCorrectiveAction / VerifyCorrectiveAction
    IssueCertificate / SuspendCertificate / RenewCertificate
    GenerateInspectionAct / GenerateFindingsSummary / GenerateCertificateDocument
    ..reciben objetos del modelo, puertos y java.time.Clock..
  }
}

CertificationEligibility <|.. NoBlockingFindingsEligibility
NoBlockingFindingsEligibility ..> FindingRepository
UseCases ..> AssetRepository
UseCases ..> InspectionSchemaRepository
UseCases ..> InspectionRepository
UseCases ..> FindingRepository
UseCases ..> CertificateRepository
UseCases ..> CertificateNumbering
UseCases ..> CertificationEligibility
UseCases ..> ReadModels : los informes los construyen
UseCases ..> AuditService : el acta lee el historial
UseCases ..> AuditedInspectionGenerator
UseCases ..> AuditedFindingGenerator
UseCases ..> AuditedCertificateGenerator

package "details.inmemory" {
  class InMemoryAssetRepository
  class InMemoryInspectionSchemaRepository
  class InMemoryInspectionRepository
  class InMemoryFindingRepository
  class InMemoryCertificateRepository
  class InMemoryAuditService
  class SequentialCertificateNumbering
  AssetRepository <|.. InMemoryAssetRepository
  InspectionSchemaRepository <|.. InMemoryInspectionSchemaRepository
  InspectionRepository <|.. InMemoryInspectionRepository
  FindingRepository <|.. InMemoryFindingRepository
  CertificateRepository <|.. InMemoryCertificateRepository
  AuditService <|.. InMemoryAuditService
  CertificateNumbering <|.. SequentialCertificateNumbering
}
@enduml
