@startuml certiflow-domain
!pragma layout smetana
title Certiflow - Modelo de dominio (Entrega 2)
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

note as ExceptionsNote
  Las excepciones concretas de dominio no se dibujan.
  Viven en el subpaquete exceptions de cada concepto
  (inspection.model.exceptions, schema.model.exceptions,
  certification.model.exceptions, catalog.model.exceptions;
  las genericas, en shared.model)
  y cada una extiende una de las tres categorias de shared.model:
  NotFoundException, InvalidValueException o RuleViolationException.
end note

package "shared.model" {
  class Person <<entidad>> {
    id: PersonId
    name: String
  }
  class Stamp <<value object>> {
    author: Person
    instant: Instant
  }
  abstract class DomainException <<exception>>
  abstract class NotFoundException <<exception>>
  abstract class InvalidValueException <<exception>>
  abstract class RuleViolationException <<exception>>
  Stamp --> Person
  DomainException <|-- NotFoundException
  DomainException <|-- InvalidValueException
  DomainException <|-- RuleViolationException
}

package "shared.model (auditoria)" {
  interface "AuditLog<S>" as AuditLog <<puerto>> {
    +record(S, AuditEntry)
    +historyOf(S): List<AuditEntry>
    +recordAll(S, List<AuditEntry>)
  }
  class AuditTrail {
    +record(AuditAction, Stamp, detail)
    +pull(): List<AuditEntry>
  }
  class AuditEntry <<value object>> {
    action: AuditAction
    performed: Stamp
    detail: String
  }
  interface AuditAction <<enum extensible>> {
    +code(): String
    +name(): String
    +label(): String
  }
  class AuditActionCatalog <<coleccion de primera clase>> {
    +withCode(String): Optional<AuditAction>
    +all(): List<AuditAction>
  }
  AuditLog ..> AuditEntry
  AuditEntry --> AuditAction
  AuditEntry --> Stamp
  AuditActionCatalog o-- "*" AuditAction
}

package "catalog.model" {
  class Asset <<entidad inmutable>> {
    code: AssetCode
    name: String
    type: AssetType
    location: Location
    responsible: Person
    characteristics: Characteristics
    jurisdictionCode: JurisdictionCode
    subsystems: List<Subsystem>
  }
  class Characteristics <<value object>> {
    entries: List<Characteristic>
  }
  class Characteristic <<value object>> {
    name: String
    value: String
  }
  Asset --> Characteristics
  Characteristics *-- Characteristic
  class AssetCode <<identificador de negocio>>
  class AssetType <<value object>>
  class Location <<value object>>
  class JurisdictionCode <<identificador de negocio>>
  class Subsystem <<value object>> {
    code: SubsystemCode
    name: String
  }
  class SubsystemCode <<identificador de negocio>>
  interface SubsystemAssociation {
    +orElse(SubsystemAssociation): SubsystemAssociation
    +isAssignedTo(SubsystemCode): boolean
    +reaches(SubsystemCode): boolean
    +describedBy(SubsystemAssociationDescriber<T>): T
  }
  class NoSubsystem <<value object>>
  class InSubsystem <<value object>> {
    subsystemCode: SubsystemCode
  }
  interface "SubsystemAssociationDescriber<T>" as SubsystemAssociationDescriber {
    +noSubsystem(): T
    +inSubsystem(SubsystemCode): T
  }
  class AssignedSubsystems
  class AssetService <<servicio de dominio>> {
    -assetLog: AuditLog<AssetCode>
    -assets: AssetRepository
    -knownJurisdictions: KnownJurisdictions
    +register(Asset, Stamp): Asset
  }
  enum AssetAudit {
    REGISTERED
  }
  AuditAction <|.. AssetAudit
  AssetService ..> Asset : da de alta y audita
  Asset --> AssetCode
  Asset --> AssetType
  Asset --> Location
  Asset --> JurisdictionCode
  Asset *-- "*" Subsystem
  Subsystem --> SubsystemCode
  SubsystemAssociation <|.. NoSubsystem
  SubsystemAssociation <|.. InSubsystem
  InSubsystem --> SubsystemCode
  SubsystemAssociation ..> SubsystemAssociationDescriber
  SubsystemAssociationDescriber <|.. AssignedSubsystems
}

package "schema.model (evaluacion)" {
  interface Answer {
    +describedBy(AnswerDescriber<T>): T
  }
  interface "AnswerDescriber<T>" as AnswerDescriber {
    +number(BigDecimal): T
    +yesNo(boolean): T
    +option(String): T
  }
  class AnswerText
  class RawAnswer <<value object>> {
    text: String
  }
  class NumericAnswer <<value object>> {
    value: BigDecimal
  }
  enum YesNoAnswer {
    YES
    NO
  }
  class OptionAnswer <<value object>> {
    option: String
  }
  class Unit <<value object>>
  interface "ApprovalRule<A extends Answer>" as ApprovalRule {
    +isSatisfiedBy(A): boolean
    +answerFrom(RawAnswer): A
    +describedBy(RuleDescriber<T>): T
  }
  interface "RuleDescriber<T>" as RuleDescriber <<por clase de valor>> {
    +text(parameterName, String): RuleDescriber<T>
    +decimal(parameterName, BigDecimal): RuleDescriber<T>
    +texts(parameterName, Set<String>): RuleDescriber<T>
    +ofKind(ruleKindName): T
  }
  interface RuleParameters {
    +text(parameterName): String
    +decimal(parameterName): BigDecimal
    +texts(parameterName): Set<String>
  }
  interface ApprovalRuleKind {
    +isNamed(ruleKindName): boolean
    +ruleFrom(RuleParameters): ApprovalRule<?>
  }
  class NumericRangeRuleKind
  class YesNoRuleKind
  class OptionInListRuleKind
  class ApprovalRuleKindCatalog <<catalogo>> {
    +named(ruleKindName): Optional<ApprovalRuleKind>
  }
  class NumericRangeRule <<regla de NumericAnswer>> {
    unit: Unit
    range: Range
  }
  class YesNoRule <<regla de YesNoAnswer>> {
    expected: YesNoAnswer
  }
  class OptionInListRule <<regla de OptionAnswer>> {
    acceptedOptions: Set<String>
  }
  class Range <<value object>> {
    minimum: BigDecimal
    maximum: BigDecimal
    +contains(BigDecimal): boolean
  }
  enum Outcome {
    PENDING
    APPROVED
    OBSERVED
    REJECTED
    +raisesFinding(): boolean
  }
  interface Severity <<enum extensible>> {
    +code(): String
    +label(): String
    +outcomeWhenUnmet(): Outcome
  }
  enum StandardSeverity {
    MINOR
    MAJOR
    CRITICAL
  }
  class SeverityCatalog <<coleccion de primera clase>> {
    +withCode(String): Optional<Severity>
    +all(): List<Severity>
  }
  interface EvidenceKind <<enum extensible>> {
    +code(): String
    +label(): String
  }
  enum StandardEvidenceKind {
    PHOTO
    DOCUMENT
  }
  class EvidenceKindCatalog <<coleccion de primera clase>> {
    +withCode(String): Optional<EvidenceKind>
    +all(): List<EvidenceKind>
  }
  class Evidence <<value object>> {
    kind: EvidenceKind
    reference: String
    description: String
    +isOfKind(EvidenceKind): boolean
    +isSameFileAs(Evidence): boolean
  }
  class EvidenceRequirement <<value object>> {
    kind: EvidenceKind
    minimum: int
    +isSatisfiedBy(List<Evidence>): boolean
  }
  Answer <|.. NumericAnswer
  Answer <|.. YesNoAnswer
  Answer <|.. OptionAnswer
  Answer ..> AnswerDescriber
  AnswerDescriber <|.. AnswerText
  ApprovalRule <|.. NumericRangeRule
  ApprovalRule <|.. YesNoRule
  ApprovalRule <|.. OptionInListRule
  ApprovalRule ..> RuleDescriber : dice su tipo y sus parametros
  ApprovalRuleKind ..> RuleParameters
  ApprovalRuleKind ..> ApprovalRule : la arma de vuelta
  ApprovalRuleKind <|.. NumericRangeRuleKind
  ApprovalRuleKind <|.. YesNoRuleKind
  ApprovalRuleKind <|.. OptionInListRuleKind
  ApprovalRuleKindCatalog o-- "*" ApprovalRuleKind
  ApprovalRule ..> RawAnswer : la convierte en Answer
  NumericRangeRule --> Range
  Severity <|.. StandardSeverity
  Severity ..> Outcome
  SeverityCatalog o-- "*" Severity
  EvidenceKind <|.. StandardEvidenceKind
  EvidenceKindCatalog o-- "*" EvidenceKind
  Evidence --> EvidenceKind
  EvidenceRequirement --> EvidenceKind
}

package "schema.model" {
  class InspectionSchema <<aggregate root inmutable>> {
    name: String
    assetType: AssetType
    versionLog: SchemaVersionLog
    +withNewVersion(List<Section>, Instant publishedAt, Instant effectiveFrom, Set<SubsystemCode>): InspectionSchema
    +versionAt(Instant): SchemaVersion
    +version(int): SchemaVersion
    +latestPublishedVersion(): SchemaVersion
    +versions(): List<SchemaVersion>
  }
  class SchemaVersionLog <<value object inmutable>> {
    versions: List<SchemaVersion>
    +SchemaVersionLog(List<Section>, Instant publishedAt, Set<SubsystemCode>)
    +append(List<Section>, Instant publishedAt, Instant effectiveFrom, Set<SubsystemCode>): SchemaVersionLog
    +versionAt(Instant): SchemaVersion
    +latestPublished(): SchemaVersion
  }
  class SchemaVersion <<value object inmutable>> {
    number: int
    sections: SchemaSections
    publishedAt: Instant
    effectiveFrom: Instant
    +requiredSubsystems(): Set<SubsystemCode>
    +ensureRequires(Set<SubsystemCode>)
    +associationOf(Criterion<?>): SubsystemAssociation
    +criteriaFor(SubsystemCode): List<Criterion<?>>
    +criteria(): List<Criterion<?>>
    +section(SectionTitle): Section
    +criterion(CriterionCode): Criterion<?>
    +ensureContains(Criterion<?>)
  }
  class SchemaSections <<coleccion de primera clase>> {
    all: List<Section>
    +criteria(): List<Criterion<?>>
    +withTitle(SectionTitle): Section
    +withCode(CriterionCode): Criterion<?>
    +ensureContains(Criterion<?>)
    +associationOf(Criterion<?>): SubsystemAssociation
    +assignedTo(SubsystemCode): List<Criterion<?>>
    +assignedSubsystems(): Set<SubsystemCode>
    +hasCriteriaWithoutSubsystem(): boolean
  }
  class Section <<value object>> {
    title: SectionTitle
    criteria: List<Criterion<?>>
    subsystem: SubsystemAssociation
  }
  class SectionTitle <<value object>>
  class "Criterion<A extends Answer>" as Criterion <<value object>> {
    code: CriterionCode
    text: String
    rule: ApprovalRule<A>
    severity: Severity
    requiredEvidence: List<EvidenceRequirement>
    subsystem: SubsystemAssociation
    +outcomeOf(A): Outcome
    +answerFrom(RawAnswer): A
    +evidenceRequirementsMetBy(List<Evidence>): boolean
  }
  class CriterionCode <<value object>>
  class InspectionSchemaService <<servicio de dominio>> {
    -auditLog: AuditLog<AssetType>
    +create(name, AssetType, List<Section>, Stamp, Set<SubsystemCode>): InspectionSchema
    +publishVersion(InspectionSchema, List<Section>, Stamp, Instant effectiveFrom, Set<SubsystemCode>): InspectionSchema
  }
  enum SchemaAudit {
    CREATED
    VERSION_ADDED
  }
  AuditAction <|.. SchemaAudit
  InspectionSchemaService ..> InspectionSchema : crea versiones y audita
  InspectionSchema *-- SchemaVersionLog
  SchemaVersionLog "1" *-- "1..*" SchemaVersion
  SchemaVersion *-- SchemaSections
  SchemaSections *-- "1..*" Section
  Section *-- "1..*" Criterion
  Section --> SectionTitle
  Section --> SubsystemAssociation
  Criterion --> CriterionCode
  Criterion --> SubsystemAssociation
  Criterion --> ApprovalRule
  Criterion --> Severity
  Criterion --> "*" EvidenceRequirement
  InspectionSchema --> AssetType
}

package "inspection.model" {
  interface InspectionView <<solo lectura>> {
    +id(): InspectionId
    +evaluate(): Evaluation
    +isClosed(): boolean
    +closedAt(): Optional<Instant>
    +originalRevision(): Revision
    +revisions(): Revisions
    +assetCode(): AssetCode
    +assetType(): AssetType
    +assetResponsible(): Person
    +coversWholeSchema(): boolean
    +assignment(): InspectionAssignment
    +schemaVersion(): SchemaVersion
  }
  class InspectionId <<identificador>>
  class Inspection <<aggregate root>> {
    -responses: Map<Criterion<?>, CriterionResponse<?>>
    -revisions: Revisions
    -auditTrail: AuditTrail
    ~recordAnswer(Criterion<A>, A, Stamp)
    ~attachEvidence(Criterion<?>, Evidence, Stamp)
    ~addObservation(Criterion<?>, String, Stamp)
    ~close(Stamp): InspectionClosed
    ~rectify(Criterion<A>, A, reason, Stamp): InspectionRectified
    ~pullAuditEntries(): List<AuditEntry>
    +ensureClosed()
    +covers(SubsystemCode): boolean
  }
  class InspectionFactory {
    +create(InspectionId, Asset, InspectionAssignment, SchemaVersion, Stamp): Inspection
  }
  class InspectionService <<servicio de dominio>> {
    -inspectionFactory: InspectionFactory
    -inspectionLog: AuditLog<InspectionId>
    +assign(InspectionId, Asset, InspectionAssignment, SchemaVersion, Stamp): Inspection
    +recordAnswer(Inspection, CriterionCode, RawAnswer, Stamp)
    +attachEvidence(Inspection, CriterionCode, Evidence, Stamp)
    +addObservation(Inspection, CriterionCode, String, Stamp)
    +close(Inspection, Stamp): InspectionClosed
    +rectify(Inspection, CriterionCode, RawAnswer, reason, Stamp): InspectionRectified
  }
  interface RaisesFindings {
    +inspectionId(): InspectionId
    +assetCode(): AssetCode
    +assetResponsible(): Person
    +nonConformities(): List<CriterionResponse<?>>
    +raised(): Stamp
    +schemaVersion(): SchemaVersion
  }
  class InspectionClosed <<evento de dominio>> {
    inspectionId: InspectionId
    assetCode: AssetCode
    assetResponsible: Person
    nonConformities: List<CriterionResponse<?>>
    closed: Stamp
    schemaVersion: SchemaVersion
  }
  class InspectionRectified <<evento de dominio>> {
    inspectionId: InspectionId
    assetCode: AssetCode
    assetResponsible: Person
    nonConformities: List<CriterionResponse<?>>
    rectified: Stamp
    schemaVersion: SchemaVersion
  }
  class InspectionAssignment <<value object>> {
    inspector: Person
    plannedDate: LocalDate
    scope: InspectionScope
  }
  interface InspectionScope {
    +criteriaIn(SchemaVersion): List<Criterion<?>>
    +describedBy(InspectionScopeDescriber<T>): T
  }
  interface "InspectionScopeDescriber<T>" as InspectionScopeDescriber {
    +full(): T
    +sections(Set<SectionTitle>): T
  }
  class FullScope <<value object>>
  class SectionsScope <<value object>> {
    sectionTitles: Set<SectionTitle>
  }
  InspectionScope <|.. FullScope
  InspectionScope <|.. SectionsScope
  InspectionScope ..> InspectionScopeDescriber
  SectionsScope --> "1..*" SectionTitle
  InspectionAssignment --> InspectionScope
  class "CriterionResponse<A extends Answer>" as CriterionResponse <<value object inmutable>> {
    criterion: Criterion<A>
    answering: Answering<A>
    attachments: List<AttachedEvidence>
    observations: List<Observation>
    +given(): Optional<GivenAnswer<A>>
    +answeredWith(Criterion<B>, B, Stamp): CriterionResponse<B>
    +withEvidence(Evidence, Stamp)
    +withObservation(Observation)
    +outcome(): Outcome
    +isFor(Criterion<?>): boolean
  }
  interface "Answering<A extends Answer>" as Answering {
    +outcomeFor(Criterion<A>, List<Evidence>): Outcome
    +describedBy(AnsweringDescriber<A, T>): T
  }
  class "NotAnswered<A extends Answer>" as NotAnswered <<value object>>
  class "GivenAnswer<A extends Answer>" as GivenAnswer <<value object>> {
    value: A
    answered: Stamp
  }
  interface "AnsweringDescriber<A extends Answer, T>" as AnsweringDescriber {
    +notAnswered(): T
    +answered(GivenAnswer<A>): T
  }
  class AttachedEvidence <<value object>> {
    evidence: Evidence
    attached: Stamp
  }
  class Observation <<value object>> {
    text: String
    observed: Stamp
  }
  class Evaluation <<value object>> {
    responses: List<CriterionResponse<?>>
    +pending(): List<CriterionResponse<?>>
    +nonConformities(): List<CriterionResponse<?>>
    +ensureComplete()
  }
  class Revisions <<coleccion de primera clase>> {
    revisions: List<Revision>
    +sealedWith(reason, Evaluation, Stamp): Revisions
    +original(): Revision
    +last(): Revision
    +firstSealedAt(): Optional<Instant>
    +isEmpty(): boolean
    +asList(): List<Revision>
  }
  class Revision <<value object>> {
    number: int
    reason: String
    evaluation: Evaluation
    sealed: Stamp
  }
  enum InspectionAudit {
    ASSIGNED
    ANSWER_RECORDED
    EVIDENCE_ATTACHED
    OBSERVATION_ADDED
    CLOSED
    RECTIFIED
  }
  InspectionView <|.. Inspection
  InspectionFactory ..> Inspection : crea
  Inspection *-- AuditTrail
  Inspection --> InspectionId
  Inspection --> AssetCode : por codigo
  Inspection --> InspectionAssignment
  Inspection --> SchemaVersion : fijada al asignar
  Inspection *-- "*" CriterionResponse
  Inspection *-- Revisions
  Revisions *-- "*" Revision
  Inspection ..> Evaluation : deriva
  Revision --> Evaluation
  Evaluation o-- "*" CriterionResponse
  CriterionResponse --> Criterion
  CriterionResponse --> Answering
  Answering <|.. NotAnswered
  Answering <|.. GivenAnswer
  Answering ..> AnsweringDescriber
  CriterionResponse --> "*" AttachedEvidence
  CriterionResponse --> "*" Observation
  GivenAnswer --> Answer
  AttachedEvidence --> Evidence
  RaisesFindings <|.. InspectionClosed
  RaisesFindings <|.. InspectionRectified
  AuditAction <|.. InspectionAudit
}

package "inspection.model (hallazgos)" {
  class Finding <<aggregate root>> {
    -auditTrail: AuditTrail
    ~planAction(ActionPlan, Stamp, LocalDate): CorrectiveAction
    ~verifyAction(CorrectiveActionId, VerificationResult, notes, Stamp): Verification
    +isOpen(): boolean
    +concerns(AssetCode): boolean
    +isOpenFor(InspectionId, CriterionResponse<?>): boolean
    +id(): FindingId
    +assetCode(): AssetCode
    +inspectionId(): InspectionId
    +criterion(): Criterion<?>
    +subsystem(): SubsystemAssociation
    +severity(): Severity
    +evidence(): List<AttachedEvidence>
    +responsible(): Person
    +actions(): List<CorrectiveAction>
    ~pullAuditEntries(): List<AuditEntry>
  }
  class FindingFactory {
    +create(FindingId, RaisesFindings, CriterionResponse<?>): Finding
  }
  class FindingService <<servicio de dominio>> {
    -findingFactory: FindingFactory
    -findingLog: AuditLog<FindingId>
    +raiseFrom(InspectionClosed, Supplier<FindingId>): List<Finding>
    +raiseFrom(InspectionRectified, List<Finding>, Supplier<FindingId>): List<Finding>
    +planAction(Finding, ActionPlan, Stamp, LocalDate): CorrectiveAction
    +verifyAction(Finding, CorrectiveActionId, VerificationResult, notes, Stamp): Verification
  }
  class CorrectiveActions <<coleccion de primera clase, de paquete>> {
    ~plan(ActionPlan, Stamp, LocalDate): CorrectiveAction
    ~withId(CorrectiveActionId): CorrectiveAction
    ~cancelOpen(Stamp)
    ~noneAccepted(): boolean
    ~asList(): List<CorrectiveAction>
  }
  class CorrectiveAction <<entidad interna>> {
    -id: CorrectiveActionId
    -plan: ActionPlan
    -planned: Stamp
    -verifications: List<Verification>
    -cancellation: CancellationState
    ~verify(VerificationResult, notes, Stamp): Verification
    ~cancel(Stamp)
    +isClosed(): boolean
    +isCancelled(): boolean
    +isOpen(): boolean
    +isOverdueOn(LocalDate): boolean
  }
  class ActionPlan <<value object>> {
    description: String
    responsible: Person
    dueDate: LocalDate
    ~ensureDueOnOrAfter(LocalDate)
  }
  class Verification <<value object>> {
    result: VerificationResult
    notes: String
    verified: Stamp
    +isAccepted(): boolean
  }
  enum VerificationResult {
    ACCEPTED
    REJECTED
    +closesAction(): boolean
    +requiresNotes(): boolean
    +audit(): FindingAudit
  }
  interface CancellationState {
    +isCancelled(): boolean
    +describedBy(CancellationStateDescriber<T>): T
  }
  class NotCancelled <<value object>>
  class Cancellation <<value object>> {
    cancelled: Stamp
  }
  interface "CancellationStateDescriber<T>" as CancellationStateDescriber {
    +notCancelled(): T
    +cancelled(Cancellation): T
  }
  enum FindingAudit {
    RAISED
    ACTION_PLANNED
    VERIFICATION_ACCEPTED
    VERIFICATION_REJECTED
  }
  FindingFactory ..> Finding : crea
  FindingFactory ..> RaisesFindings : a partir de
  Finding *-- CorrectiveActions
  CorrectiveActions *-- CorrectiveAction
  Finding *-- AuditTrail
  Finding --> InspectionId : por id
  Finding --> Criterion
  Finding --> SubsystemAssociation
  Finding --> "*" AttachedEvidence
  CorrectiveAction --> ActionPlan
  CorrectiveAction *-- "*" Verification
  CorrectiveAction --> CancellationState
  CancellationState <|.. NotCancelled
  CancellationState <|.. Cancellation
  CancellationState ..> CancellationStateDescriber
  Verification --> VerificationResult
  AuditAction <|.. FindingAudit
}

package "certification.model" {
  class Certificate <<aggregate root>> {
    -lifecycle: CertificateLifecycle
    -auditTrail: AuditTrail
    ~suspend(reason, Stamp, LocalDate)
    ~ensureRenewableWith(InspectionResult)
    ~ensureReplaceableByGlobal(DecidedGlobalCertification)
    ~renewedBy(Certificate, Stamp)
    +statusOn(LocalDate, List<Certificate>): CertificateStatus
    +isCurrentOn(LocalDate): boolean
    +isCurrentFor(CertificationScope, LocalDate): boolean
    +certifies(AssetCode): boolean
    +isIssuedFor(SchemaReference): boolean
    +wasDecidedUnder(JurisdictionCode): boolean
    +certifiedSubsystems(): List<SubsystemCode>
    +number(): CertificateNumber
    +assetCode(): AssetCode
    +basis(): CertificateBasis
    +decision(): GrantedDecision
    +scope(): CertificationScope
    +schemaReference(): SchemaReference
    +validity(): ValidityPeriod
    +latestInspectionClosedAt(): Instant
    +issuedBy(): Person
    +issuedAt(): Instant
    +suspensions(): List<Suspension>
    ~pullAuditEntries(): List<AuditEntry>
  }
  class CertificateFactory {
    +create(CertificateNumber, InspectionResult, GrantedDecision, Stamp): Certificate
    +createGlobal(CertificateNumber, DecidedGlobalCertification, Person): Certificate
  }
  class CertificateService <<servicio de dominio>> {
    -certificateFactory: CertificateFactory
    -certificateLog: AuditLog<CertificateNumber>
    +issue(CertificateNumber, InspectionResult, GrantedDecision, Stamp): Certificate
    +ensureRenewableWith(Certificate, InspectionResult)
    +renew(Certificate, CertificateNumber, GrantedDecision, InspectionResult, Stamp): Certificate
    +suspend(Certificate, reason, Stamp, LocalDate)
    +issueGlobal(CertificateNumber, DecidedGlobalCertification, Person): Certificate
    +ensureGlobalRenewable(Certificate, DecidedGlobalCertification)
    +markRenewed(Certificate, Certificate, Stamp)
  }
  class AssetCertificates <<coleccion de primera clase>> {
    assetCode: AssetCode
    certificates: List<Certificate>
    +ensureScopeAvailable(CertificationScope, LocalDate)
    +ensureScopeAvailableToReplace(Certificate, CertificationScope, LocalDate)
    +statusOf(Certificate, LocalDate): CertificateStatus
  }
  class CertificateNumber <<identificador de negocio>>
  class ValidityPeriod <<value object>> {
    validFrom: LocalDate
    validUntil: LocalDate
    +covers(LocalDate): boolean
  }
  interface ValidityTerm {
    +startingOn(LocalDate): ValidityPeriod
  }
  class MonthsTerm <<value object>> {
    months: int
  }
  class DaysTerm <<value object>> {
    days: int
  }
  class Suspension <<value object>> {
    reason: String
    suspended: Stamp
  }
  interface CertificationScope {
    +narrow(InspectionResult): InspectionResult
    +requiresPartialCertificates(List<SubsystemResult>): boolean
    +describedBy(CertificationScopeDescriber<T>): T
  }
  class WholeAssetScope <<value object>>
  class SubsystemScope <<value object>> {
    subsystemCode: SubsystemCode
  }
  interface "CertificationScopeDescriber<T>" as CertificationScopeDescriber {
    +wholeAsset(): T
    +subsystem(SubsystemCode): T
  }
  interface CertificateBasis {
    +latestInspectionClosedAt(): Instant
    +isSupportedOn(LocalDate, List<Certificate>): boolean
    +ensureBacksGlobalCertificate(CertificateNumber)
    +describedBy(CertificateBasisDescriber<T>): T
  }
  class InspectionBasis <<value object>> {
    inspection: InspectionReference
  }
  class PartialCertificatesBasis <<value object>> {
    partialCertificateNumbers: List<CertificateNumber>
    globalPolicyCode: PolicyCode
    latestInspectionClosedAt: Instant
  }
  interface "CertificateBasisDescriber<T>" as CertificateBasisDescriber {
    +inspection(InspectionReference): T
    +partialCertificates(List<CertificateNumber>, PolicyCode, Instant): T
  }
  class InspectionReference <<value object>> {
    id: InspectionId
    closedAt: Instant
  }
  class SchemaReference <<value object>> {
    assetType: AssetType
    number: int
  }
  enum CertificateLifecycle {
    ISSUED
    SUSPENDED
    RENEWED
    ~statusOn(ValidityPeriod, LocalDate): CertificateStatus
    ~isReplaced(): boolean
  }
  enum CertificateStatus {
    DEPENDENCY_INVALID
    ACTIVE
    EXPIRED
    SUSPENDED
    RENEWED
