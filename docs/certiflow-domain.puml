  }
  enum CertificateAudit {
    ISSUED
    SUSPENDED
    RENEWED
  }
  CertificateFactory ..> Certificate : crea
  Certificate *-- AuditTrail
  Certificate --> CertificateNumber
  Certificate --> AssetCode : por codigo
  Certificate --> CertificateBasis : basis
  Certificate --> SchemaReference
  Certificate --> CertificateLifecycle
  Certificate *-- "*" Suspension
  CertificateLifecycle ..> CertificateStatus : deriva
  AssetCertificates o-- "*" Certificate
  CertificateBasis <|.. InspectionBasis
  CertificateBasis <|.. PartialCertificatesBasis
  CertificateBasis ..> CertificateBasisDescriber
  InspectionBasis --> InspectionReference : id + cierre
  InspectionReference --> InspectionId
  PartialCertificatesBasis --> "*" CertificateNumber : parciales
  CertificationScope <|.. WholeAssetScope
  CertificationScope <|.. SubsystemScope
  CertificationScope ..> CertificationScopeDescriber
  SubsystemScope --> SubsystemCode
  ValidityTerm <|.. MonthsTerm
  ValidityTerm <|.. DaysTerm
  ValidityTerm ..> ValidityPeriod
  AuditAction <|.. CertificateAudit
}

package "<contexto>.repository" {
  interface AssetRepository {
    +add(Asset)
    +findByCode(AssetCode): Optional<Asset>
    +findAll(): List<Asset>
  }
  interface AssetLock <<puerto>> {
    +lock(AssetCode)
  }
  interface KnownJurisdictions <<puerto>> {
    +isKnown(JurisdictionCode): boolean
  }
  interface InspectionSchemaRepository {
    +add(InspectionSchema)
    +save(InspectionSchema)
    +findForUpdate(AssetType): Optional<InspectionSchema>
    +findByAssetType(AssetType): Optional<InspectionSchema>
    +findPage(PageRequest): Page<InspectionSchema>
  }
  interface InspectionRepository {
    +nextId(): InspectionId
    +save(Inspection)
    +findById(InspectionId): Optional<Inspection>
    +assetCodeOf(InspectionId): Optional<AssetCode>
    +findByAsset(AssetCode): List<Inspection>
    +findAll(): List<Inspection>
  }
  interface FindingRepository {
    +nextId(): FindingId
    +save(Finding)
    +saveAll(List<Finding>)
    +findById(FindingId): Optional<Finding>
