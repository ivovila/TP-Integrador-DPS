    +findAll(): List<Certificate>
  }
  interface CertificateNumbering {
    +next(): CertificateNumber
  }
}

package "certification.model (elegibilidad)" {
  class CertificationEligibility <<servicio de dominio>> {
    -commonRequirements: Requirements<InspectionResult>
    -certificationPolicies: CertificationPolicyResolver
    +decide(CertificationAssessmentContext): CertificationDecision
  }
  class CertificationAssessmentContext <<value object>> {
    result: InspectionResult
    jurisdictionCode: JurisdictionCode
    evaluatedAt: Instant
    issuanceDate: LocalDate
  }
  class "Requirement<T>" as Requirement <<value object>> {
    isMet: Predicate<T>
    reason: IneligibilityReason
    detail: Function<T, String>
    ~isMetBy(T): boolean
    ~ineligibilityOf(T): Ineligibility
  }
  class "Requirements<T>" as Requirements <<coleccion de primera clase>> {
    requirements: List<Requirement<T>>
    +unmetBy(T): List<Ineligibility>
    +areMetBy(T): boolean
  }
  interface CertificationPolicyResolver <<puerto>> {
    +find(JurisdictionCode): Optional<CertificationPolicy>
    +resolve(JurisdictionCode): CertificationPolicy
  }
  interface RegisteredJurisdictions <<puerto>> {
    +all(): List<JurisdictionPolicy>
  }
  class JurisdictionPolicy <<value object>> {
    jurisdictionCode: JurisdictionCode
    policyCode: PolicyCode
  }
  class PolicyCode <<value object>>
  interface CertificationPolicy <<politica intercambiable>> {
    +code(): PolicyCode
    +evaluate(CertificationAssessmentContext): CertificationDecision
  }
  class SeverityCertificationPolicy {
    -code: PolicyCode
    -treatments: Map<Severity, FindingTreatment>
    -approvedTerm: ValidityTerm
  }
  class PolicyAssessment {
    +block(IneligibilityReason, OpenNonConformity)
    +requireCondition(OpenNonConformity, ValidityTerm)
    ~decision(): CertificationDecision
  }
  interface FindingTreatment {
    +applyTo(OpenNonConformity, PolicyAssessment)
  }
  enum StandardFindingTreatment {
    BLOCKS
    TOLERATED
    UNSUPPORTED
  }
  class ConditionalTreatment <<value object>> {
    conditionalTerm: ValidityTerm
  }
  interface GlobalCertificationPolicy <<politica intercambiable>> {
    +code(): PolicyCode
    +evaluate(GlobalAssessmentContext): CertificationDecision
  }
  class AllRequiredSubsystemsPolicy
  class GlobalAssessmentContext <<value object>> {
    assetCode: AssetCode
    schemaReference: SchemaReference
    requiredSubsystems: Set<SubsystemCode>
    partials: List<Certificate>
    jurisdictionCode: JurisdictionCode
    issuanceDate: LocalDate
    evaluatedAt: Instant
    +latestInspectionClosedAt(): Instant
    +decidedWith(GrantedDecision, PolicyCode): DecidedGlobalCertification
  }
  interface CertificationDecision {
    +outcome(): CertificationOutcome
    +isEligible(): boolean
    +ensureGranted(): GrantedDecision
    +policyCode(): PolicyCode
    +jurisdictionCode(): JurisdictionCode
    +evaluatedAt(): Instant
    +scope(): CertificationScope
    +describedBy(CertificationDecisionDescriber<T>): T
  }
  class GrantedDecision <<value object>> {
    conditions: List<CertificationCondition>
    validity: ValidityPeriod
    policyCode: PolicyCode
    jurisdictionCode: JurisdictionCode
    evaluatedAt: Instant
    scope: CertificationScope
  }
  class RejectedDecision <<value object>> {
    ineligibilities: List<Ineligibility>
    policyCode: PolicyCode
    jurisdictionCode: JurisdictionCode
    evaluatedAt: Instant
    scope: CertificationScope
  }
  interface "CertificationDecisionDescriber<T>" as CertificationDecisionDescriber {
    +granted(GrantedDecision): T
    +rejected(RejectedDecision): T
  }
  enum CertificationOutcome {
    APPROVED
    CONDITIONAL
    REJECTED
  }
  class CertificationCondition <<value object>> {
    findingId: String
    criterionCode: String
    description: String
    dueDate: LocalDate
  }
  class Ineligibility <<value object>> {
    reason: IneligibilityReason
    detail: String
  }
  interface IneligibilityReason <<enum extensible>> {
    +code(): String
  }
  enum StandardIneligibilityReason {
    UNSUPPORTED_SEVERITY
    MISSING_SUBSYSTEM
    INVALID_PARTIAL_CERTIFICATE
    INSPECTION_NOT_CLOSED
    PARTIAL_INSPECTION
    REQUIRES_PARTIAL_CERTIFICATES
    BLOCKING_FINDINGS
  }
  class DecidedCertification <<value object>> {
    result: InspectionResult
    decision: GrantedDecision
    +assetCode(): AssetCode
    +scope(): CertificationScope
    +validFrom(): LocalDate
    +decidedAt(): Instant
  }
  class DecidedGlobalCertification <<value object>> {
    assetCode: AssetCode
    schemaReference: SchemaReference
    requiredSubsystems: Set<SubsystemCode>
    partialNumbers: List<CertificateNumber>
    globalPolicyCode: PolicyCode
    latestInspectionClosedAt: Instant
    decision: GrantedDecision
    +scope(): CertificationScope
    +validFrom(): LocalDate
    +decidedAt(): Instant
    +certificateBasis(): CertificateBasis
  }
  class InspectionResult <<value object, ACL>> {
    inspectionId: InspectionId
    assetCode: AssetCode
    closure: InspectionClosure
    coversWholeSchema: boolean
    openNonConformities: List<OpenNonConformity>
    schemaReference: SchemaReference
    subsystems: List<SubsystemResult>
    scope: CertificationScope
    +forScope(CertificationScope): InspectionResult
    +requiresPartialCertificates(): boolean
    +isClosed(): boolean
    +reference(): InspectionReference
  }
  interface InspectionClosure {
    +isClosed(): boolean
    +referenceOf(InspectionId): InspectionReference
  }
  class StillOpen <<value object>>
  class ClosedAt <<value object>> {
    closedAt: Instant
  }
  class SubsystemResult <<value object>> {
    code: SubsystemCode
    covered: boolean
    openNonConformities: List<OpenNonConformity>
  }
  class OpenNonConformity <<value object>> {
    criterionCode: String
    severity: Severity
    findingId: String
    subsystem: SubsystemAssociation
    +affects(SubsystemCode): boolean
  }
  interface InspectionResultTranslator <<puerto del ACL>> {
    +assetCodeOf(InspectionId): AssetCode
    +translate(InspectionId): InspectionResult
  }
  CertificationEligibility ..> CertificationAssessmentContext
  CertificationAssessmentContext --> InspectionResult
  CertificationEligibility --> Requirements : requisitos comunes
  Requirements *-- "*" Requirement
  Requirement --> IneligibilityReason
  CertificationEligibility --> CertificationPolicyResolver
  CertificationPolicyResolver ..> CertificationPolicy : por jurisdiccion
  RegisteredJurisdictions ..> JurisdictionPolicy
  CertificationPolicy <|.. SeverityCertificationPolicy
  SeverityCertificationPolicy --> "*" FindingTreatment : por Severity
  SeverityCertificationPolicy --> ValidityTerm : vigencia aprobada
  SeverityCertificationPolicy ..> PolicyAssessment
  FindingTreatment <|.. StandardFindingTreatment
  FindingTreatment <|.. ConditionalTreatment
  FindingTreatment ..> PolicyAssessment
  ConditionalTreatment --> ValidityTerm
  PolicyAssessment ..> CertificationDecision
  GlobalCertificationPolicy <|.. AllRequiredSubsystemsPolicy
  GlobalCertificationPolicy ..> GlobalAssessmentContext
  AllRequiredSubsystemsPolicy ..> Requirements
  GlobalAssessmentContext ..> DecidedGlobalCertification
  InspectionResult *-- OpenNonConformity
  InspectionResult *-- "*" SubsystemResult
  InspectionResult --> InspectionClosure
  InspectionResult --> CertificationScope
  InspectionResult --> SchemaReference
  InspectionClosure <|.. StillOpen
  InspectionClosure <|.. ClosedAt
  SubsystemResult *-- "*" OpenNonConformity
  InspectionResultTranslator ..> InspectionResult
  CertificationEligibility ..> CertificationDecision
  CertificationDecision <|.. GrantedDecision
  CertificationDecision <|.. RejectedDecision
  CertificationDecision ..> CertificationDecisionDescriber
  CertificationDecision ..> CertificationOutcome
  CertificationDecision --> CertificationScope
  CertificationDecision --> PolicyCode
  GrantedDecision *-- "*" CertificationCondition
  GrantedDecision --> ValidityPeriod
  RejectedDecision *-- "*" Ineligibility
  Ineligibility --> IneligibilityReason
  IneligibilityReason <|.. StandardIneligibilityReason
  Certificate --> GrantedDecision : decision
  PartialCertificatesBasis --> PolicyCode
  DecidedCertification --> InspectionResult
  DecidedCertification --> GrantedDecision
  DecidedGlobalCertification --> GrantedDecision
  CertificateFactory ..> DecidedGlobalCertification
}

package "<contexto>.usecase (certiflow-domain)" {
  interface "Casos de uso: una interfaz por caso" as UseCases <<puertos de entrada>> {
    RegisterAsset / FindAsset / ListAssets
    CreateInspectionSchema / PublishSchemaVersion
    FindSchema / ListSchemas / FindEffectiveSchemaVersion
    AssignInspection
    RecordAnswer / AttachEvidence / AddObservation
    CloseInspection / RectifyInspection
    FindInspection / ListInspections
    PlanCorrectiveAction / VerifyCorrectiveAction
    FindFinding / ListFindings
    IssueCertificate / SuspendCertificate / RenewCertificate / EvaluateCertification
    IssueGlobalCertificate / RenewGlobalCertificate
    FindCertificate / ListCertificates / ListJurisdictions
    GenerateInspectionAct / GenerateFindingsSummary / GenerateCertificateDocument
    AssetHistory / SchemaHistory / InspectionHistory / FindingHistory / CertificateHistory
    ..los que modifican reciben un XxxCommand con ids y codigos..
  }
  class "Modelos de lectura (<contexto>.usecase)" as ReadModels {
    InspectionAct / ActLine
    FindingsSummary / FindingLine
    CertificateDocument / CertificateView
    ..records sin formato; FindingsSummary.openFindings() se deriva..
  }
  interface RequestedEffectiveDate <<schema.usecase>> {
    +resolveAt(Instant publishedAt): Instant
  }
  class EffectiveOnPublication <<value object>>
  class EffectiveFrom <<value object>> {
    effectiveFrom: Instant
  }
  interface RequestedRenewalScope <<certification.usecase>> {
    +resolveAgainst(CertificationScope): CertificationScope
  }
  class SameScopeAsCurrent <<value object>>
  class ExplicitRenewalScope <<value object>> {
    requestedScope: CertificationScope
  }
  UseCases ..> ReadModels : los informes los devuelven
  UseCases ..> RequestedEffectiveDate : PublishSchemaVersionCommand
  UseCases ..> RequestedRenewalScope : RenewCertificateCommand
  RequestedEffectiveDate <|.. EffectiveOnPublication
  RequestedEffectiveDate <|.. EffectiveFrom
  RequestedRenewalScope <|.. SameScopeAsCurrent
  RequestedRenewalScope <|.. ExplicitRenewalScope
  ExplicitRenewalScope --> CertificationScope
}

package "application.<contexto> (certiflow-application)" {
  class "XxxUseCaseImpl implements XxxUseCase" as Interactors {
    ..una implementación por caso de uso..
