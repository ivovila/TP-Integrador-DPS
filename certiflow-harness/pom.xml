<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>ar.edu.itba</groupId>
    <artifactId>certiflow</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>certiflow-harness</artifactId>
  <name>Certiflow - harness de evaluación del asistente (fuera de la aplicación)</name>
  <dependencies>
    <!-- Arma las inspecciones con el dominio y las traduce con el mismo traductor que la aplicación. -->
    <dependency>
      <groupId>ar.edu.itba</groupId>
      <artifactId>certiflow-application</artifactId>
    </dependency>
    <!-- El stub, el adaptador de Spring AI y su configuración: mide exactamente lo que corre la aplicación. -->
    <dependency>
      <groupId>ar.edu.itba</groupId>
      <artifactId>certiflow-infrastructure</artifactId>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <!-- mvn -pl certiflow-harness exec:exec -Dharness.args="run" (o "compare <base> <candidata>"). -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <executable>java</executable>
          <workingDirectory>${project.basedir}</workingDirectory>
          <commandlineArgs>-classpath %classpath ar.edu.itba.certiflow.harness.HarnessCommand ${harness.args}</commandlineArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <properties>
    <harness.args>run</harness.args>
  </properties>
</project>
